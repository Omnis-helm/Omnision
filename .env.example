# Omnision Environment Template
# Copy this file to .env and fill in what you need. Real environment variables take precedence.

# --- Performance & local optimization ---
PREFER_LOCAL_TOOLS=True          # True: TF-IDF vector store (no embedding API). False: FAISS + embeddings if installed
ENABLE_LLM_CACHE=True            # cache identical LLM prompts (zero-credit repeat runs)
ENABLE_LOCAL_ML_MODELS=True
ENABLE_DENSE_EMBEDDINGS=False    # True: use sentence-transformers all-MiniLM-L6-v2 for semantic similarity
ENABLE_WEB_INTELLIGENCE=False    # True: corroborate competitor/macro evidence with yfinance + FinBERT
ENABLE_LIVENESS_SIMULATION=False # True: randomly fail 10% of operational-lever liveness pings

# --- Default LLM provider: mock | ollama | openai | anthropic | gemini ---
LLM_PROVIDER=mock

# --- Cloud provider keys (public providers are restricted to EXECUTIVE_VP) ---
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
HF_TOKEN=your_huggingface_token_here

# --- Model names (override to whatever your account has access to) ---
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_MODEL=gemini-2.5-flash

# --- Ollama (100% private local models) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- REST API token signing secret (set a long random string so tokens survive restarts) ---
OMNISION_API_SECRET=
